	"components": {
		"schemas": {
			"CreateTaskRequest": {
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1,
						"title": "Title",
						"description": "Task title (required, non-empty).",
						"examples": ["Implement search endpoint"]
					},
					"description": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Description",
						"description": "Optional long description.",
						"examples": ["Add POST /api/tasks/search with filters."]
					},
					"status": {
						"$ref": "#/components/schemas/StatusTask",
						"description": "Initial workflow status.",
						"default": "backlog"
					},
					"priority": {
						"$ref": "#/components/schemas/PriorityTask",
						"description": "Initial priority.",
						"default": "low"
					},
					"task_type": {
						"$ref": "#/components/schemas/TypeTask",
						"description": "Task category.",
						"default": "other"
					},
					"pull_request_url": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Pull Request Url",
						"description": "Optional link to a pull request.",
						"examples": ["https://github.com/org/repo/pull/42"]
					}
				},
				"type": "object",
				"required": ["title"],
				"title": "CreateTaskRequest",
				"description": "Payload for creating a task.",
				"example": {
					"description": "Add POST /api/tasks/search with filters.",
					"priority": "medium",
					"pull_request_url": "https://github.com/org/repo/pull/42",
					"status": "backlog",
					"task_type": "feature",
					"title": "Implement search endpoint"
				}
			},
			"HTTPValidationError": {
				"properties": {
					"detail": {
						"items": {
							"$ref": "#/components/schemas/ValidationError"
						},
						"type": "array",
						"title": "Detail"
					}
				},
				"type": "object",
				"title": "HTTPValidationError"
			},
			"ListTaskResponse": {
				"properties": {
					"count": {
						"type": "integer",
						"title": "Count",
						"description": "Number of tasks in `tasks`."
					},
					"finished_within_weeks": {
						"type": "integer",
						"title": "Finished Within Weeks",
						"description": "Echo of the request filter (0 means filter was ignored)."
					},
					"tasks": {
						"items": {
							"$ref": "#/components/schemas/TaskResponse"
						},
						"type": "array",
						"title": "Tasks",
						"description": "Matching tasks."
					}
				},
				"type": "object",
				"required": ["count", "finished_within_weeks", "tasks"],
				"title": "ListTaskResponse",
				"description": "Task search result with metadata.",
				"example": {
					"count": 2,
					"finished_within_weeks": 0,
					"tasks": [
						{
							"id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
							"priority": "high",
							"status": "in_progress",
							"title": "Implement search endpoint",
							"user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
						}
					]
				}
			},
			"LoginRequest": {
				"properties": {
					"email": {
						"type": "string",
						"title": "Email",
						"description": "Registered email address.",
						"examples": ["user@example.com"]
					},
					"password": {
						"type": "string",
						"title": "Password",
						"description": "Account password.",
						"examples": ["Secret@123"]
					}
				},
				"type": "object",
				"required": ["email", "password"],
				"title": "LoginRequest",
				"description": "Credentials for user authentication."
			},
			"PingResponse": {
				"properties": {
					"message": {
						"type": "string",
						"title": "Message",
						"default": "pong"
					}
				},
				"type": "object",
				"title": "PingResponse",
				"description": "Response body for the ping endpoint."
			},
			"PriorityTask": {
				"type": "string",
				"enum": ["low", "medium", "high", "critical"],
				"title": "PriorityTask",
				"description": "Task priority level."
			},
			"RegisterRequest": {
				"properties": {
					"email": {
						"type": "string",
						"title": "Email",
						"description": "Unique email address.",
						"examples": ["user@example.com"]
					},
					"password": {
						"type": "string",
						"title": "Password",
						"description": "Password (8-20 chars, mixed case, digit, special).",
						"examples": ["Secret@123"]
					},
					"name": {
						"type": "string",
						"title": "Name",
						"description": "Display name.",
						"examples": ["Jane Doe"]
					}
				},
				"type": "object",
				"required": ["email", "password", "name"],
				"title": "RegisterRequest",
				"description": "Payload for user registration."
			},
			"StatusTask": {
				"type": "string",
				"enum": ["backlog", "to_do", "in_progress", "on_review", "done", "cancelled"],
				"title": "StatusTask",
				"description": "Task workflow status."
			},
			"SuccessResponse": {
				"properties": {
					"success": {
						"type": "boolean",
						"title": "Success",
						"description": "Whether the operation completed successfully.",
						"default": true
					}
				},
				"type": "object",
				"title": "SuccessResponse",
				"description": "Generic success flag for simple API actions.",
				"example": {
					"success": true
				}
			},
			"TaskDetailResponse": {
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid",
						"title": "Id",
						"description": "Task identifier."
