						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/api/users/login": {
			"post": {
				"tags": ["Users"],
				"summary": "Log in",
				"description": "Authenticate with email and password. Returns an access token in the body and sets a refresh token in an HTTP-only cookie.",
				"operationId": "login_api_users_login_post",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LoginRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TokenResponse"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid access token."
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/api/users/refresh": {
			"post": {
				"tags": ["Users"],
				"summary": "Refresh access token",
				"description": "Exchange the `refresh_token` cookie for a new access token. The cookie is rotated on success.",
				"operationId": "refresh_tokens_api_users_refresh_post",
				"parameters": [
					{
						"name": "refresh_token",
						"in": "cookie",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							],
							"description": "Refresh JWT (set automatically after login).",
							"title": "Refresh Token"
						},
						"description": "Refresh JWT (set automatically after login)."
					}
				],
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TokenResponse"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid access token."
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/api/users/logout": {
			"post": {
				"tags": ["Users"],
				"summary": "Log out",
				"description": "Clear the refresh token cookie. Does not invalidate the access token.",
				"operationId": "logout_api_users_logout_post",
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SuccessResponse"
								}
							}
						}
					}
				}
			}
		},
		"/api/users/me": {
			"get": {
				"tags": ["Users"],
				"summary": "Current user profile",
				"description": "Return the profile of the user identified by the Bearer token.",
				"operationId": "get_me_api_users_me_get",
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserResponse"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid access token."
					}
				},
				"security": [
					{
						"HTTPBearer": []
					}
				]
			}
		},
		"/api/users/{user_id}": {
			"get": {
				"tags": ["Users"],
				"summary": "Get user by ID",
				"description": "Any authenticated user can view any profile.",
				"operationId": "get_user_by_id_api_users__user_id__get",
				"security": [
					{
						"HTTPBearer": []
					}
				],
				"parameters": [
					{
						"name": "user_id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid",
							"title": "User Id"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Successful Response",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserResponse"
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid access token."
